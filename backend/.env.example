PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mangaview
DB_USER=postgres
DB_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=cambiar_esto
# Vida del token de sesion. Acortarlo reduce la ventana de un token robado
# (trade-off T-01 de la evaluacion ATAM).
JWT_EXPIRES_IN=7d
# Factor de coste de bcrypt (punto de sensibilidad S-01). Cada unidad duplica el
# tiempo de computo y bcryptjs lo ejecuta en el hilo principal de Node.js.
BCRYPT_ROUNDS=10
